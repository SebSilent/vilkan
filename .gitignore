# ---------------------------------------------------------------------------
# RULE #1: nothing from the game (or any other proprietary source) is ever
# committed.
# Everything is built from files the user supplies at runtime.
# This file is the first line of defence; `cargo xtask policy` (also run by
# the pre-commit hook in .githooks/) is the second and is authoritative.
# See docs/asset-policy.md.
# ---------------------------------------------------------------------------

# Build output
/target/
/tests/fixtures/*/target/

# Local configuration (contains paths to YOUR files)
/vilkan.toml

# Local provenance/attribution notes (not for publication)
/LOCAL-NOTES.md

# Places people tend to drop data into. Keep data outside the repo instead.
/game/
/games/
/assets/
/data/
/dump/
/dumps/
/extracted/
/cache/
/out/

# Game-derived analysis and captured shaders live OUTSIDE the tree (in the
# external data dir, e.g. ../vilkan-data/analysis/). Never commit them.
/analysis/
/docs/shaders/
*.dxil
*.dxbc
*.cso
*.spv

# Executables, libraries, symbols
*.exe
*.dll
*.pdb
*.lib
*.sys
*.obj
*.exp
*.ilk

# Console packages and containers
*.xvd
*.xvc
*.msixvc
*.xsp
*.cab
*.msi

# Typical game data (non-exhaustive on purpose; the policy check is an allowlist)
*.bin
*.dat
*.pak
*.rpf
*.dds
*.ktx
*.ktx2
*.dxbc
*.dxil
*.cso
*.spv
*.wav
*.xma
*.ogg
*.opus
*.mp3
*.mp4
*.bik
*.bk2
*.awc
*.zip
*.7z
*.rar

scripts/scrub-map.local.py

# Python bytecode (the compiler sidecar is .py)
__pycache__/
*.pyc

# Backup / scratch dirs and files (the git-history backup lives outside the
# tree; never commit a backup made inside it).
/backup/
/backups/
*-backup/
*.bak
*.orig
*.rej

# Editor / OS noise
.vs/
.idea/
*.swp
Thumbs.db
.DS_Store

# Local goal/authorization notes (not for publication)
/GOAL.local.md
